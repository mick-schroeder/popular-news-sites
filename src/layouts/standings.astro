---
// A standings page: the current standings (/) or one year's (/year/2024/).
// The same hero, the list as chart or posters, and the list as structured data.
import BrandIcon from "@/components/brand-icon.astro"
import {
  type Choice,
  type ListedMovie,
  Standings,
} from "@/components/standings"
import { buttonVariants } from "@/components/ui/button"
import { SITE } from "@/consts"
import Layout from "@/layouts/base.astro"
import { getYears } from "@/lib/movies"
import { Braces } from "lucide-react"
import { siGithub, siMdblist, siThemoviedatabase } from "simple-icons"
import lists from "../../pipeline/lists.json"

interface Props {
  title: string
  description: string
  choice: Choice
  /** The page's movies, best first. */
  listed: ListedMovie[]
  /** The list's name, for structured data. */
  listName: string
}
const { title, description, choice, listed, listName } = Astro.props

const years = getYears()
const json =
  choice === "current" ? "/best-pictures.json" : `/best-pictures-${choice}.json`
// The page's lists on MDBList and TMDB, which pnpm sync:lists keeps in step
const followLists = lists[json.slice(1) as keyof typeof lists]

const jsonLd = [
  {
    "@type": "ItemList",
    name: listName,
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    numberOfItems: listed.length,
    itemListElement: listed.map((movie, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(movie.href, SITE.url).href,
      name: movie.title,
    })),
  },
]
---

<Layout {title} {description} {jsonLd} hideTitle>
  <section class="relative overflow-hidden pb-6">
    <div class="px-4 pt-8 sm:px-6 sm:pt-12">
      <h1 class="font-heading text-[clamp(3.25rem,13vw,11rem)] leading-[0.82] font-extrabold tracking-[-0.055em]">
        <span class="mb-[0.3em] block text-[clamp(1.5rem,4vw,3.25rem)] leading-none font-bold tracking-[-0.03em]">
          Mick Schroeder’s
        </span>{" "}
        {SITE.title}
        {choice !== "current" && <span class="block"> {choice}</span>}
      </h1>
      <p class="mt-4 text-xl font-medium text-balance text-muted-foreground sm:text-2xl">
        {description}
      </p>
      <!-- The page's own list file; /about/#feeds has them all -->
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={json} class={buttonVariants({ variant: "outline" })}>
          <Braces aria-hidden="true" />
          JSON feed
        </a>
        <a
          href={SITE.code}
          target="_blank"
          rel="noopener"
          class={buttonVariants({ variant: "outline" })}
        >
          <BrandIcon icon={siGithub} />
          Source
        </a>
        {followLists && (
          <>
            <a
              href={`https://mdblist.com/lists/${followLists.mdblist}`}
              target="_blank"
              rel="noopener"
              class={buttonVariants({ variant: "outline" })}
            >
              <BrandIcon icon={siMdblist} />
              MDBList
            </a>
            <a
              href={`https://www.themoviedb.org/list/${followLists.tmdb}`}
              target="_blank"
              rel="noopener"
              class={buttonVariants({ variant: "outline" })}
            >
              <BrandIcon icon={siThemoviedatabase} />
              TMDB
            </a>
          </>
        )}
      </div>
    </div>
    <Standings client:load years={years} choice={choice} listed={listed} />
  </section>
</Layout>
