---
import BaseHead, {
  type Props as HeadProps,
} from "@/components/site/base-head.astro"
import SiteFooter from "@/components/site/site-footer.astro"
import SiteHeader from "@/components/site/site-header.astro"
import BrandIcon from "@/components/brand-icon.astro"
import { siMdblist, siThemoviedatabase } from "simple-icons"
import { SITE } from "@/consts"
import { ClientRouter } from "astro:transitions"
import "@/styles/global.css"

type Props = HeadProps & {
  /** Leave the header's site title out, when the page shows it large itself. */
  hideTitle?: boolean
}
const { hideTitle = false, ...head } = Astro.props
---

<html lang="en">
  <head>
    <BaseHead {...head} />
    <ClientRouter />
  </head>
  <body class="antialiased">
    <!-- App-like: the page fills one screen, with the footer below it -->
    <div class="flex min-h-svh flex-col">
      <SiteHeader name={SITE.name} hideTitle={hideTitle}>
        <nav aria-label="Site">
          <ul class="flex gap-4 text-sm text-muted-foreground">
            {[
              { name: "Current", href: "/" },
              { name: "By year", href: "/year/" },
              { name: "About", href: "/about/" },
            ].map(({ name, href }) => (
              <li>
                <a
                  href={href}
                  class="hover:text-foreground aria-[current=page]:text-foreground"
                  aria-current={
                    Astro.url.pathname === href ? "page" : undefined
                  }
                >
                  {name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </SiteHeader>
      <main class="flex flex-1 flex-col">
        <slot />
      </main>
    </div>
    <div class="px-4 sm:px-6">
      <SiteFooter code={SITE.code}>
        <div class="flex flex-col gap-2">
          <p class="flex items-center gap-2">
            <BrandIcon icon={siMdblist} />
            <span>
              Ratings data from{" "}
              <a
                href="https://mdblist.com/"
                target="_blank"
                rel="noopener"
                class="underline hover:text-foreground"
              >
                MDBList
              </a>
              .
            </span>
          </p>
          <p class="flex items-center gap-2">
            <a
              href="https://www.themoviedb.org/"
              target="_blank"
              rel="noopener"
              aria-label="TMDB"
            >
              <BrandIcon icon={siThemoviedatabase} />
            </a>
            <span>
              This product uses the TMDB API but is not endorsed or certified by
              TMDB.
            </span>
          </p>
        </div>
      </SiteFooter>
    </div>
  </body>
</html>
