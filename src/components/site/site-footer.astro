---
import { NETWORK, OWNER } from "./network"

interface Props {
  /** This site's source code, linked beside the privacy policy. */
  code?: string
}

const { code } = Astro.props

const year = new Date().getFullYear()
const here = Astro.site?.origin
---

<footer class="mt-16 flex flex-col gap-6 border-t py-8 text-sm text-muted-foreground">
  <slot />
  <nav aria-label="More sites">
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      {NETWORK.filter(({ url }) => new URL(url).origin !== here).map(
        ({ name, url }) => (
          <li>
            <a
              href={url}
              target="_blank"
              rel="noopener"
              class="hover:text-foreground"
            >
              {name}
            </a>
          </li>
        )
      )}
    </ul>
  </nav>
  <p class="flex flex-wrap gap-x-4 gap-y-1">
    <span>
      {`© ${year} `}
      <a
        href={OWNER.url}
        target="_blank"
        rel="noopener"
        class="hover:text-foreground"
      >
        {OWNER.name}
      </a>
    </span>
    <a
      href={OWNER.privacy}
      target="_blank"
      rel="noopener"
      class="hover:text-foreground"
    >
      Privacy policy
    </a>
    {code && (
      <a
        href={code}
        target="_blank"
        rel="noopener"
        class="hover:text-foreground"
      >
        Source code
      </a>
    )}
  </p>
</footer>
