---
// A movie's years in the standings as one joyplot: its ridge inked bold among a few made-up low ridges,
// there only for the look (later rows in front, its own on top), with its key nights pinned to it.
// Full page width, stretched to whatever height the page leaves it; rendered at build time.
import * as d3 from "d3"
import { getSpan, type MovieSummary } from "@/lib/movies"
import {
  DAY,
  handInked,
  ridgeArea,
  ridgeLine,
  RUNOUT_DAYS,
  utc,
} from "@/lib/ridgeline"

interface Props {
  movie: MovieSummary
}

const { movie } = Astro.props
const first = movie.years[0]!
const last = movie.years.at(-1)!
const span = first === last ? `${first}` : `${first}–${last}`
const { start, end, ridges } = await getSpan(first, last)
const id = String(movie.id)
const ridge = ridges.find((r) => r.id === id)!

// Made-up rows behind and in front of it
const CONTEXT = 4
const ROWS = CONTEXT * 2 + 1

// A fixed drawing box stretched to the page; lines keep their thickness
const W = 1000
const GAP = 14
const PEAK = 56
const BOLD = 1.3
const TOP = PEAK * BOLD + 12
const H = TOP + (ROWS - 1) * GAP + 6
// Past the last night, a short run-out where every line eases down to flat
const x = d3.scaleUtc([start, end + RUNOUT_DAYS * DAY], [0, W])

// A gentle low ridge, the same for this movie on every build: a couple of slow
// swells, never more than a fifth of a real peak
function madeUp(seed: string): [number, number][] {
  const random = d3.randomLcg(d3.sum(seed, (c) => c.charCodeAt(0)) / 997)
  const swells = Array.from({ length: 2 }, () => ({
    at: random() * W,
    width: 40 + random() * 120,
    height: 0.05 + random() * 0.15,
  }))
  return d3
    .range(0, W + 1, 10)
    .map((px) => [
      px,
      d3.sum(
        swells,
        (s) => s.height * Math.exp(-(((px - s.at) / s.width) ** 2))
      ),
    ])
}

const mine = ridge.points.map(([t, h]): [number, number] => [x(t), h * BOLD])
const rows = d3.range(ROWS).map((i) => {
  const on = i === CONTEXT
  const base = TOP + i * GAP
  const shape = (on ? mine : madeUp(`${id}-${i}`)).map(
    ([px, h]): [number, number] => [px, h * PEAK]
  )
  const points = handInked(on ? id : `${id}-${i}`, shape, W)
  return { on, base, points, area: ridgeArea(points)!, ink: ridgeLine(points)! }
})
const { base, points: inked } = rows[CONTEXT]!

// Pins on its ridge: released, first ranked, best, and now or last ranked
const at = (date: string): [number, number] => {
  const [px, py] =
    inked[Math.min(inked.length - 1, Math.round((utc(date) - start) / DAY))]!
  return [px, base + py]
}
// A single year heads the chart, so the pins leave it out: "May 17"; over
// several they keep it: "May 17, 2020"
const day = (date: string) =>
  new Date(utc(date)).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: first === last ? undefined : "numeric",
    timeZone: "UTC",
  })
const inYear = (date: string | null): date is string =>
  !!date && utc(date) >= start && utc(date) < end
const { release_date, firstNight, bestNight, lastNight, best, current } = movie
const pins: { date: string; label: string; accent?: boolean }[] = []
const released = inYear(release_date) && utc(release_date) < end
// A dot on its baseline at the release, as on the standings chart
const releaseX = released ? x(utc(release_date)) : null
if (released) {
  pins.push({
    date: release_date,
    label: `Released ${day(release_date)}`,
  })
}
if (inYear(firstNight)) {
  const atBest = bestNight === firstNight ? ` · Peak #${best}` : ""
  pins.push({
    date: firstNight,
    label: `Added ${day(firstNight)}${atBest}`,
  })
}
if (inYear(bestNight) && bestNight !== firstNight) {
  pins.push({ date: bestNight, label: `Peak #${best}` })
}
if (inYear(lastNight) && lastNight !== firstNight) {
  pins.push(
    current
      ? { date: lastNight, label: `Now #${current}`, accent: true }
      : { date: lastNight, label: `Dropped ${day(lastNight)}` }
  )
}

// Pins a few days apart share one label
const placed: { label: string; accent?: boolean; left: number; top: number }[] =
  []
for (const pin of pins.toSorted((a, b) => a.date.localeCompare(b.date))) {
  const [px, py] = at(pin.date)
  const left = (px / W) * 100
  const near = placed.at(-1)
  if (near && left - near.left < 6) {
    near.label += ` · ${pin.label}`
    if (pin.accent) near.accent = true
  } else {
    placed.push({ ...pin, left, top: (py / H) * 100 })
  }
}

// Where each label goes: on the low row or the tall one above it, running
// right or left of its stem. Every arrangement is tried (there are at most four
// pins) and the first that fits wins: on the chart, no two labels in a row
// overlapping, and no tall stem passing through a low label. Widths are
// guessed for a phone, the tightest fit; wider screens only have more room.
const PHONE = 375
const widthOf = (label: string) =>
  (Math.min(label.length * 6.5 + 8, 0.42 * PHONE) / PHONE) * 100
type Spot = { tall: boolean; right: boolean }
function problems(spots: Spot[]) {
  const spans = spots.map(({ right }, i): [number, number] => {
    const { left, label } = placed[i]!
    return right ? [left, left + widthOf(label)] : [left - widthOf(label), left]
  })
  let count = 0
  spots.forEach((spot, i) => {
    const [from, to] = spans[i]!
    if (from < 0 || to > 100) count++
    spots.forEach((other, j) => {
      if (j === i) return
      const crossed = from < placed[j]!.left && placed[j]!.left < to
      if (!spot.tall && other.tall && crossed) count++
      const [otherFrom, otherTo] = spans[j]!
      if (j > i && spot.tall === other.tall && from < otherTo && otherFrom < to)
        count++
    })
  })
  // Short stems and labels leaning toward the middle, all else equal
  return count + spots.filter((spot) => spot.tall).length / 100
}
const spots = d3.least(
  d3.range(4 ** placed.length).map((n) =>
    placed.map((_, i): Spot => {
      const bits = Math.floor(n / 4 ** i) % 4
      return { tall: bits >= 2, right: bits % 2 === 1 }
    })
  ),
  problems
)!

// Every month for one year; over several, fewer, with each January as its year
const months = d3.utcMonth
  .every(last - first + 1)!
  .range(new Date(start), new Date(end - 14 * DAY))
  .map((date) => ({
    left: (x(date) / W) * 100,
    label:
      first !== last && date.getUTCMonth() === 0
        ? String(date.getUTCFullYear())
        : date.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }),
  }))
---

<figure class="movie-joyplot">
  <figcaption class="year px-4 font-heading font-bold sm:px-6">
    {span}
  </figcaption>
  <div class="plot">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="none"
      role="img"
      aria-label={`How high ${movie.title} ranked in ${span}`}
    >
      {/* Its own ridge drawn last, so no row covers it */}
      {rows
        .toSorted((a, b) => +a.on - +b.on)
        .map(({ on, base, area, ink }) => (
          <g class:list={[on && "on"]} transform={`translate(0,${base})`}>
            <path class="fill" d={area} />
            <path class="ink" d={ink} />
            {on && releaseX !== null && (
              <path class="release" d={`M${releaseX},0h0`} />
            )}
          </g>
        ))}
    </svg>
    {placed.map(({ label, left, top, accent }, i) => (
      <div
        class:list={[
          "pin",
          spots[i]!.right ? "start" : "end",
          spots[i]!.tall && "tall",
          accent && "accent",
        ]}
        style={`left:${left}%;--y:${top}%`}
      >
        <span>{label}</span>
      </div>
    ))}
  </div>
  <div class="months" aria-hidden="true">
    {months.map(({ left, label }) => (
      <span style={`left:${left}%`}>{label}</span>
    ))}
  </div>
</figure>

<style>
  /* Fills the height it's given; the drawing stretches to it */
  .movie-joyplot {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  /* The year, quietly heading the chart */
  .year {
    margin-top: 2rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
  }
  /* Room above for the pins' labels */
  .plot {
    position: relative;
    flex: 1;
    min-height: 220px;
    margin-top: 4.5rem;
  }
  .plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fill {
    fill: var(--background);
  }
  .ink {
    fill: none;
    stroke: var(--muted-foreground);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* A zero-length round-capped stroke, so the stretched drawing keeps it round */
  /* Sized against the bold ridge line as the chart's dots are against theirs */
  .release {
    stroke: var(--foreground);
    stroke-width: 6.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .on .ink {
    stroke: var(--foreground);
    stroke-width: 2.25;
  }
  /* A stem from its night on the ridge up past the chart's top, where every
     label sits, clear of the ridges; alternate pins reach a row higher */
  .pin {
    position: absolute;
    top: -0.5rem;
    height: calc(var(--y) + 0.5rem);
    border-left: 1px solid currentColor;
    color: var(--foreground);
    font-size: 13px;
  }
  .pin.accent {
    color: var(--primary);
  }
  .pin.tall {
    top: -3rem;
    height: calc(var(--y) + 3rem);
  }
  .pin span {
    position: absolute;
    bottom: 100%;
    width: max-content;
    max-width: min(16rem, 42vw);
    padding: 2px 4px;
    line-height: 1.25;
    /* A halo, so a neighbouring stem passing behind stays readable */
    text-shadow:
      0 0 2px var(--background),
      0 0 2px var(--background),
      0 0 4px var(--background);
  }
  .pin.start span {
    left: 0;
  }
  .pin.end span {
    right: 0;
    text-align: right;
  }
  .months {
    position: relative;
    height: 2rem;
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .months span {
    position: absolute;
    top: 0.5rem;
    padding-left: 6px;
  }
</style>
